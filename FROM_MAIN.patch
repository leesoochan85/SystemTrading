+      })}
+      {dates.filter((_, i) => i % Math.max(1, Math.ceil(dates.length / 6)) === 0 || i === dates.length - 1).map((d) => <text key={d} x={x(d)} y="280" textAnchor="middle" className="chart-axis-label">{`${d.slice(4, 6)}/${d.slice(6, 8)}`}</text>)}
