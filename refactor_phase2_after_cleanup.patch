+def delete_position_strategy(code, *, context):
+    db_schema.init_position_strategy_table(context=context)
+    with context.connect(context.position_db) as con:
+        con.execute(
+            "DELETE FROM position_strategy WHERE code = ?", (str(code).zfill(6),)
+        )
